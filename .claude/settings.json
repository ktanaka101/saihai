{
  "permissions": {
    "deny": [
      "Read(~/codes/saihai-evals/**)",
      "Edit(~/codes/saihai-evals/**)",
      "Bash(*saihai-evals*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/guard-main.mjs\"",
            "statusMessage": "main への直接の反映を確認中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/check-goals.mjs\" --hook",
            "statusMessage": "ゴール文書の書式を検査中"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/check-goals.mjs\" --stop",
            "statusMessage": "ゴール文書の書式を検査中"
          }
        ]
      }
    ]
  }
}
