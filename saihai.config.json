{
  "command": "node bin/saihai.mjs",
  "hidden": [
    "check-goals"
  ],
  "gate": {
    "goalCheck": false,
    "checks": [
      {
        "name": "ゴール文書の検査",
        "cmd": [
          "node",
          "tools/check-goals.mjs"
        ]
      },
      {
        "name": "テスト",
        "cmd": [
          "npm",
          "test",
          "--silent"
        ]
      },
      {
        "name": "隠しシナリオ（check-goals）",
        "cmd": [
          "node",
          "tools/eval-hidden.mjs",
          "run",
          "check-goals"
        ]
      },
      {
        "name": "監査（保管場所への許可された接触がない）",
        "cmd": [
          "node",
          "tools/eval-hidden.mjs",
          "audit"
        ]
      }
    ]
  },
  "probes": {
    "実装後の落とし穴": {
      "command": "printf '%s %s\\n' \"$(git log main --format=%s | grep -c '^fix')\" \"$(git log main --merges --format=%s | grep -c '門番を通過')\"",
      "examples": [
        "G3（仮説）"
      ]
    }
  }
}
