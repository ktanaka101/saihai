{
  "name": "saihai",
  "private": true,
  "description": "人は采配を振るだけ。ゴール設定・現実からの観測・解釈と次の判断を支え、実装は AI に任せるフレームワーク",
  "bin": {
    "saihai": "bin/saihai.mjs"
  },
  "scripts": {
    "check": "node bin/saihai.mjs check",
    "eval": "node tools/eval-goals.mjs",
    "eval:split": "node tools/eval-split.mjs",
    "eval:hidden": "node tools/eval-hidden.mjs",
    "gate": "node bin/saihai.mjs gate",
    "goal:new": "node bin/saihai.mjs new",
    "observe": "node bin/saihai.mjs observe",
    "brief": "node bin/saihai.mjs brief",
    "log": "node bin/saihai.mjs log",
    "inbox": "node bin/saihai.mjs inbox",
    "aar": "node bin/saihai.mjs aar",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80",
    "init": "node bin/saihai.mjs init"
  },
  "engines": {
    "node": ">=22.8"
  }
}
