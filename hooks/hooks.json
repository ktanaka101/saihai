{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/saihai context --root \"${CLAUDE_PROJECT_DIR}\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/saihai guard --root \"${CLAUDE_PROJECT_DIR}\"", "statusMessage": "main への直接の反映を確認中" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/saihai check --hook --root \"${CLAUDE_PROJECT_DIR}\"", "statusMessage": "ゴール文書の書式を検査中" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/saihai check --stop --root \"${CLAUDE_PROJECT_DIR}\"", "statusMessage": "ゴール文書の書式を検査中" }
        ]
      }
    ]
  }
}
